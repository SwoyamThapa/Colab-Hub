PORT=5001
NODE_ENV=development

# Comma-separated allowed browser origins. Omit to allow any origin (reflected) with credentials. Use * for the same open policy explicitly.
# CORS_ORIGINS=*

MONGODB_URI=your_mongo_connection_string_here
JWT_SECRET=your_jwt_secret_here

# Google Gemini (workspace chat @ColabBot)
GEMINI_API_KEY=your_gemini_api_key_here
# MongoDB ObjectId of a User document used as the bot sender (create a dedicated "ColabBot" user in DB)
BOT_USER_ID=your_bot_user_object_id_here

